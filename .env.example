# Copy this file to `.env.local` and fill in values. Never commit `.env.local`.
# Vite docs: https://vite.dev/guide/env-and-mode.html
#
# Only variables prefixed with VITE_ are exposed to browser code via import.meta.env.
# Those values are still embedded in the built client bundle — keep secrets server-side.

# Example (uncomment and set when you add a client-safe public URL):
# VITE_PUBLIC_API_URL=

# Chatbot → Groq (server-only; loaded by Vite middleware + Vercel api/chat.js)
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=
# Optional override (default: llama-3.1-8b-instant)
# GROQ_MODEL=llama-3.1-8b-instant

# Optional client overrides:
# VITE_CHAT_API_URL=/api/chat
